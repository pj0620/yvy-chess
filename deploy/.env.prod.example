# Copy to deploy/.env.prod (gitignored) and fill in.
DOMAIN=chess.example.com
POSTGRES_PASSWORD=change-me-to-something-long
# Sent to chess.com in the User-Agent header, as their API terms ask.
YVY_CONTACT=you@example.com
# Leave empty for no password (only do that behind Tailscale or similar).
YVY_PASSWORD=choose-a-password
# Stockfish think time per move; lower it on a very small server.
YVY_ENGINE_MOVETIME_MS=300
