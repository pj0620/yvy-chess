# Copy to .env (gitignored). Every value is optional; these are the defaults.
# Host port for the Compose Postgres (change it if 5432 is taken on your machine).
YVY_DB_PORT=5432
DATABASE_URL=postgres://yvy:yvy@localhost:5432/yvy
# Where the Rust server listens in dev. The Bun dev server proxies /api to it.
YVY_BIND=127.0.0.1:8080
# Host port of the app container in the "full" Compose profile.
YVY_APP_PORT=8080
STOCKFISH_PATH=stockfish
YVY_CONTACT=you@example.com
RUST_LOG=info,yvy_server=debug
# Optional: require this password (HTTP Basic) for every request except /api/health.
YVY_PASSWORD=
